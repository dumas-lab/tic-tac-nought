{
  "name": "tic-tac-nought",
  "productName": "Tic Tac Nought",
  "version": "0.3.0",
  "description": "Tic-tac-toe that keeps growing. Build a run, collect powers, chase the score.",
  "private": true,
  "license": "UNLICENSED",
  "author": "dumas-lab",
  "homepage": "https://dumas-lab.github.io/tic-tac-nought/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dumas-lab/tic-tac-nought.git"
  },
  "desktopName": "tic-tac-nought.desktop",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "npm run build:web && electron .",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:electron": "node scripts/test-electron.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "dist:linux": "npm run build:web && electron-builder --linux AppImage deb --x64",
    "dist:win": "npm run build:web && electron-builder --win portable nsis --x64",
    "checksums": "node scripts/checksums.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  }
}
